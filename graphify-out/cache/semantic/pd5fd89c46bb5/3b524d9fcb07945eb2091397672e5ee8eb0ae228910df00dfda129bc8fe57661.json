screen", "label": "B6: Fulfillment and Warehouse Split Screen", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_b7_subscription_billing_screen", "label": "B7: Subscription and Billing Screen", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_b8_customer_portal_negotiation_screen", "label": "B8: Customer Portal Negotiation Screen", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_b9_deal_health_anomaly_dashboard", "label": "B9: Deal Health and Anomaly Dashboard", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_end_to_end_flow", "label": "Complete Flow (End-to-End)", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_why_hackathon_important", "label": "Why This Hackathon Problem Is Important", "file_type": "rationale", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Justifies the hackathon problem: mirrors a real B2B end-to-end sales workflow (Quotation -> Approval -> Fulfillment -> Billing -> Customer Negotiation -> Reporting), focuses teams on business logic (discount approvals, warehouse splitting, subscription billing, margin impact, customer negotiation) rather than UI polish, and pushes production-like system thinking with role-based access, approval chains, inventory coordination, recurring billing, audit trails, and deal analytics."}, {"id": "doc_dealflow360_technical_guidelines", "label": "Technical Guidelines", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teams may use any tech stack (language, framework, database) because the focus is business logic, data modeling, and workflow, not platform; core business rules (approval routing, discount governance, warehouse splitting, billing proration) must be implemented in real application logic, not hardcoded or faked for the demo; the customer facing negotiation screen must be a real, separate, restricted view; multi currency/multi company support is a bonus, not required."}, {"id": "doc_dealflow360_deliverables", "label": "Deliverables", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_quick_test_flow", "label": "Quick Test Flow (Login to Payment)", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_blended_discount_risk_score", "label": "Blended Discount Risk Score", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides whether a quotation needs manager (and finance) approval by checking every order line against its own category-specific discount limit rather than one overall order limit, then computing a blended score across the whole order. This prevents a rep from keeping every individual line technically within limits while still discounting the overall order more than intended, and catches the case where many small per-line overages add up (each a little over its own limit) without any single line looking alarming alone. It exists so managers are not stuck reviewing every quotation by hand, only the risky ones."}, {"id": "doc_dealflow360_multi_tier_discount_governance", "label": "Multi Tier Discount Governance and Automated Approval Routing", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_upsell_cross_sell_recommendations", "label": "Live Upsell and Cross Sell Recommendations", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_multi_warehouse_fulfillment_splitting", "label": "Multi Warehouse Fulfillment Splitting and Backorder Handling", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_hybrid_billing", "label": "Hybrid Billing (One Time + Recurring Subscription Lines)", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_deal_health_anomaly_alerts", "label": "Deal Health Monitoring and Anomaly Alerts", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_customer_facing_portal_negotiation", "label": "Customer Facing Portal Negotiation on Live Quotations", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_sales_backend_configuration_reporting", "label": "Sales Backend Configuration and Reporting Dashboards", "file_type": "concept", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_dealflow360_excalidraw_mockup", "label": "Excalidraw Mockup Link", "file_type": "document", "source_file": "doc/DealFlow360.pdf", "source_location": null, "source_url": "https://app.excalidraw.com/l/65VNwvy7c4X/7Fb5SR3WKu2", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doc_dealflow360_project", "target": "doc_dealflow360_project_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/DealFlow360.pdf", "source_location": null, "weight": 1.0}, {"source": "doc_dealflow360_project", "target": "doc_dealflow360_goals_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/DealFlow360.pdf", "source_location": null, "weight": 1.0}, {"source": "doc_dealflow360_project", "target": "doc_dealflow360_user_roles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/DealFlow360.pdf", "source_location": null, "weight": 1.0}, {"source": "doc_dealflow360_project", "target": "doc_dealflow360_sales_backend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/DealFlow360.pdf", "source_location": null, "weight": 1.0}, {"source": "doc_dealflow360_project", "target": "doc_dealflow360_sales_frontend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/DealFlow360.pdf", "source_location": null, "weight": 1.0}, {"source": "doc_dealflow360_project", "target": "doc_dealflow360_end_to_end_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "doc/DealFlow360.pdf", "source_location": null, "weight": 1.0}, {"source": "doc_dealflow360_project", "target": "doc_dealflow360