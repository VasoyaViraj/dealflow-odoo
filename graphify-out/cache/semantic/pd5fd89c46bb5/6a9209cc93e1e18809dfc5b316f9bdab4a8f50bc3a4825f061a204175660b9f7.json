business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_quotation_business_rules_quotationservice_ts", "label": "quotationService.ts", "file_type": "code", "source_file": "doc/quotation_business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_quotation_business_rules_rounding_policy", "label": "Rounding policy: round-per-step, 2dp ROUND_HALF_UP", "file_type": "rationale", "source_file": "doc/quotation_business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rounding each value as it is produced (rather than rounding only at the end) keeps the returned document internally consistent \u2014 the shown numbers actually subtract/add to each other."}, {"id": "doc_quotation_business_rules_last_line_absorbs_residue", "label": "Last line absorbs rounding residue", "file_type": "rationale", "source_file": "doc/quotation_business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ensures sum of allocated discount shares equals the quotation discount amount exactly, avoiding a paisa/cent shortfall from naive equal division."}, {"id": "doc_quotation_business_rules_discount_governance", "label": "Discount governance (stricter of tier vs category limit)", "file_type": "rationale", "source_file": "doc/quotation_business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing hardcoded; missing config defaults to 100% ceiling ('no policy') rather than 0%, since defaulting to 0 would flag every line on every order."}, {"id": "doc_quotation_business_rules_over_limit_not_rejected", "label": "Over-limit discounts recorded, not rejected", "file_type": "rationale", "source_file": "doc/quotation_business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Key Phase 3 decision: the literal spec wording would hard-reject over-limit discounts, but that is incompatible with the approval model where an over-limit discount is a legitimate request auto-routed for approval. Hard-rejecting would make the approval ladder unreachable."}, {"id": "doc_quotation_business_rules_blended_risk_score", "label": "Blended discount risk score formula", "file_type": "rationale", "source_file": "doc/quotation_business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines worstLineExcessPct (catches one badly over-limit line that value-weighting would dilute) with orderExcessPct (catches many slightly-over-limit lines that individually look fine) so neither failure mode escapes detection."}, {"id": "doc_quotation_business_rules_catalogue_snapshots", "label": "Catalogue snapshots on line add", "file_type": "rationale", "source_file": "doc/quotation_business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "productName/sku/category/unitPrice/unitCost/taxRate are copied at add-time so a later product price change doesn't silently restate an existing quotation."}, {"id": "doc_quotation_business_rules_deferred_price_lists", "label": "Deferred: Price lists", "file_type": "concept", "source_file": "doc/quotation_business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doc_quotation_business_rules_deferred_subscription_multipliers", "label": "Deferred: Subscription plan multipliers", "file_type": "concept", "source_file": "doc/quotation_business_rules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "doc_quo